# ── Stage 1: build WASM ────────────────────────────────────────────────────────
FROM rust:1.85-slim AS wasm-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
 && rm -rf /var/lib/apt/lists/* \
 && curl -fsSL https://github.com/rustwasm/wasm-pack/releases/download/v0.14.0/wasm-pack-v0.14.0-x86_64-unknown-linux-musl.tar.gz \
    | tar xz --strip-components=1 -C /usr/local/bin \
      wasm-pack-v0.14.0-x86_64-unknown-linux-musl/wasm-pack

WORKDIR /build

# Cache Cargo dependencies before copying full source
COPY Cargo.toml Cargo.lock ./
COPY crates/core/Cargo.toml  crates/core/Cargo.toml
COPY crates/cli/Cargo.toml   crates/cli/Cargo.toml
COPY crates/wasm/Cargo.toml  crates/wasm/Cargo.toml

RUN mkdir -p crates/core/src crates/cli/src crates/wasm/src \
 && echo 'pub fn stub() {}'                                                  > crates/core/src/lib.rs \
 && echo 'fn main() {}'                                                      > crates/cli/src/main.rs \
 && printf '#[wasm_bindgen::prelude::wasm_bindgen]\npub fn stub() {}\n'      > crates/wasm/src/lib.rs \
 && wasm-pack build crates/wasm --target web --out-dir ../../web/pkg \
 && rm -rf crates/*/src web/

# Build the real WASM
COPY crates/ crates/
RUN touch crates/core/src/lib.rs crates/cli/src/main.rs crates/wasm/src/lib.rs \
 && wasm-pack build crates/wasm --target web --out-dir ../../web/pkg

# Copy the web shell (index.html + logo + QR library)
COPY web/index.html          web/index.html
COPY web/mobi-521-logo-1.png web/mobi-521-logo-1.png
COPY web/qrcode.min.js       web/qrcode.min.js

# ── Stage 2: serve with nginx + TLS ───────────────────────────────────────────
FROM nginx:alpine

COPY --from=wasm-builder /build/web/ /usr/share/nginx/html/
COPY nginx.ssl.conf /etc/nginx/conf.d/default.conf

RUN chmod -R 755 /usr/share/nginx/html/ \
 && apk add --no-cache openssl \
 && mkdir -p /etc/nginx/ssl \
 && openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
      -keyout /etc/nginx/ssl/key.pem \
      -out    /etc/nginx/ssl/cert.pem \
      -subj   "/CN=localhost" \
      -addext "subjectAltName=DNS:localhost,IP:127.0.0.1"

EXPOSE 80 443
